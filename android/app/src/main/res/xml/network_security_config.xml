<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- System CAs only. Cleartext is refused, including on Android 8. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
